<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Slice 2c — the OAuth RETURN. `app.dropin.playdate` is
                `capacitor.config.ts`'s appId, used here as a custom URL scheme:
                the provider round trip finishes in the phone's browser, and
                this filter is what lets the browser hand
                `app.dropin.playdate://#access_token=…` back to the app.

                ACTION_VIEW is load-bearing, not convention: @capacitor/app's
                AppPlugin.handleOnNewIntent ignores any intent whose action is
                not ACTION_VIEW, so the `appUrlOpen` event the client listens
                for would never fire. BROWSABLE is what makes a browser
                redirect able to target it, and DEFAULT is required for an
                implicit intent to match at all.

                android:launchMode="singleTask" on the activity above is the
                other half and is deliberately NOT re-added here: it makes the
                return resume the RUNNING task with the WebView still alive
                (through onNewIntent) instead of starting a second instance.

                Deliberately NOT slice 3's https App Links: no android:autoVerify,
                no host, no assetlinks.json — those are for SHARED links.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.dropin.playdate" />
            </intent-filter>

            <!--
                Slice 3 — the SHARED link: `https://drop-in-mu.vercel.app/playdate/<id>`
                opens THIS app when installed and the web page when not.

                ⚠️ A SECOND filter, never a merged one. The scheme filter above is
                slice 2c's OAuth return and is proven working on hardware; its
                `<data android:scheme=…/>` must stay a tag with exactly ONE
                attribute, because `src/lib/oauth.test.ts` matches it with
                /<data\s+android:scheme="([^"]+)"\s*\/>/ and asserts the result
                equals the appId — an attribute added to that tag makes the match
                fail and the pin red (measured, not inferred).

                Order does NOT matter to that pin, and this was measured too:
                oauth.test.ts scans `/<intent-filter>…<\/intent-filter>/`, which
                requires an attribute-less opening tag, and this filter cannot be
                attribute-less (autoVerify is on it) — so the two never compete
                for its `.find()`. This one sits second for reading order.

                android:autoVerify="true" is what makes the OS fetch
                `https://drop-in-mu.vercel.app/.well-known/assetlinks.json` at
                install time and verify our signature against it (public/…
                ships that file). Without it Android opens the chooser or the
                browser instead — the silent failure this slice exists to fix.

                android:pathPrefix is deliberately NARROW: `/playdate/` is the
                shape `buildShareUrl` (src/lib/trust.ts) produces and the only
                thing this slice claims. The consequence, named rather than
                implied: an emailed password-reset link points at
                `/reset-password` (lib/passwordReset.ts's RESET_PATH), so it is
                NOT claimed here and keeps landing in the browser — which is
                correct today, because that token has to reach Supabase inside
                the WebView. Claiming the whole host would capture it.

                Host and prefix have ONE home in code — APP_LINK_HOST and
                APP_LINK_PATH_PREFIX in src/lib/appLinks.ts — and
                src/lib/appLinks.test.ts fails if this file drifts from them.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- scheme + host + pathPrefix in ONE tag: the three attributes
                     are ANDed, which is the intent. (A separate tag per
                     attribute is the documented way to OR values, not to
                     combine them.) -->
                <data
                    android:scheme="https"
                    android:host="drop-in-mu.vercel.app"
                    android:pathPrefix="/playdate/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
