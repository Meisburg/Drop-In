# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files.
#
# UNCOMMENTED ON PURPOSE (2026-10-05). The template ships these commented out, and
# the Play upload keystore does not exist yet, so nothing leaks today. It becomes a
# leak the moment one is created and someone runs `git add -A`, and an upload key
# in git history cannot be rotated without losing the ability to update the app.
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json
#
# ⚠️ THE LINE ABOVE IS UNCOMMENTED ON PURPOSE, AND IT IS THIS REPO'S CHOICE
# RATHER THAN CAPACITOR'S DEFAULT. `npx cap add android` wrote it commented out,
# and generators usually leave it that way because the file is harmless-ish. It is
# ignored here for three reasons:
#
#   1. IT IS MACHINE-SPECIFIC CONFIG, not source. It carries the project number,
#      the app id and an API key for THIS Firebase project. A fresh clone does not
#      have it and does not need it — `android/app/build.gradle` already checks for
#      the file and logs "Push Notifications won't work" instead of failing.
#   2. IT IS REGENERABLE IN ONE COMMAND, and that command is recorded in
#      `.scratch/native-apps/plan.md`:
#        npx firebase-tools apps:sdkconfig ANDROID <appId> --out android/app/google-services.json
#      so ignoring it costs nobody a step, while committing it would publish a
#      config blob that goes stale the moment the Firebase project changes.
#   3. THE API KEY IN IT IS BROADER THAN IT LOOKS. Firebase's Android API key is
#      restricted by app-signature on Google's side, which is why shipping it is
#      common practice — but "common practice" is not a reason to put it in a
#      PUBLIC repo (this repo is public) when one command regenerates it.

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
