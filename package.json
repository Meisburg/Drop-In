{
  "name": "drop-in",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "//": "Vite 8 needs Node ^20.19 || >=22.12 — pinned so the host cannot pick an older runtime and fail the build.",
    "node": ">=22"
  },
  "scripts": {
    "prepare": "bash scripts/install-git-hooks.sh || true",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --ignore-pattern '.scratch/**' --ignore-pattern '.agents/**' --ignore-pattern '.qa/**' --ignore-pattern 'dist/**'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "steering-lint": "bash scripts/steering-lint.sh",
    "a11y:focus": "node scripts/focus-indicator-check.mjs",
    "a11y:profile-order": "node scripts/profile-order-check.mjs",
    "guards": "bash scripts/guards/run-all.sh",
    "guards:lib": "bash scripts/guards/lib-sibling-guard.sh",
    "guards:config": "bash scripts/guards/config-guard.sh",
    "guards:nobypass": "bash scripts/guards/no-bypass-guard.sh",
    "verify": "npm run build && npm run test && npm run lint && npm run a11y:focus && npm run steering-lint && npm run guards"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.115.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "opening_hours": "^3.15.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
