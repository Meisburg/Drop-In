# Playdate env — copy this file to .env and fill in real values.
# .env is gitignored (Supabase credentials never commit); this file is the
# documented shape (README: `cp .env.example .env`).

# Supabase project (dashboard → Settings → API). Both are required —
# src/lib/db.ts throws at module load when either is missing.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-API-KEY

# Public base URL for shared drop-in links (V2 slice 5, ticket 05).
# Leave empty until deployment (DECISION 3 is deferred): the app falls
# back to window.location.origin, so share links
# (`<base>/playdate/<id>`) work in dev/preview with a placeholder.
VITE_PUBLIC_BASE_URL=