#!/usr/bin/env bash
# Pre-push gate — the machine-enforced half of the auto-push rule.
#
# WHY THIS EXISTS: AGENTS.md has always said "a safety check the agent types
# from memory is not a check" — but until now that principle was applied to ONE
# check (the push-range check) while the entire gate stack stayed advisory. No
# CI, no hooks: every gate was something an agent had to remember to run. The
# gate is only real if something enforces it.
#
# This hook runs on `git push` to origin/master and blocks when:
#   1. the pushed range contains machine-local artifacts (rule 2), or
#   2. the working tree is unverified (rule 1) — unless FAST_PUSH=1, or
#   3. the push is not a fast-forward (rule 3).
#
# Rule 1 is the expensive one (build + test + lint, ~1-2 min). It is skipped
# automatically for non-master pushes, and can be forced off with:
#     FAST_PUSH=1 git push origin master
# The range check (rule 2) is NEVER skippable — it is seconds, and it is the
# check that has already failed in production once.
# The fast-forward check (rule 3) is NEVER skippable either: a force-push is
# exactly the kind of history rewrite this rule exists to forbid.
#
# Install: see docs/agents/auto-push.md (`bash scripts/install-git-hooks.sh`).

set -uo pipefail

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: FATAL: not inside a git repository" >&2
  exit 1
}
cd "$REPO" || exit 1

ZERO="0000000000000000000000000000000000000000"
REMOTE="${1:-origin}"
FAIL=0

# --- Decide whether this push even needs gating -----------------------------
# stdin carries: <local-ref> <local-sha> <remote-ref> <remote-sha> per line.
# We keep the master/main line's shas: they are what rule 3 compares.
NEEDS_GATE=0
GATE_LOCAL_SHA=""
GATE_REMOTE_SHA=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      NEEDS_GATE=1
      GATE_LOCAL_SHA="$local_sha"
      GATE_REMOTE_SHA="$remote_sha"
      ;;
  esac
done

if [ "$NEEDS_GATE" -eq 0 ]; then
  exit 0
fi

echo "pre-push: gating a push to $REMOTE/master"

# --- Rule 3: fast-forward (never skippable) ---------------------------------
#
# V16 round 31. This check did not exist when the hook was written, and its
# ABSENCE was worse than a missing feature: the hook still printed
# "PASS — gated push ... clean and green" for a non-fast-forward push, so a
# force-push to master would have sailed through under a green banner while
# violating rule 3 (docs/agents/auto-push.md: "no force, no amend, no rebase").
# The data was already on stdin — the loop above captured `remote_sha` and threw
# it away, and ZERO was defined and never used. Reproduced before fixing: a line
# whose local sha is not a descendant of the remote sha exited 0 and printed PASS.
#
# A created branch carries an all-zero remote sha and IS a legitimate
# fast-forward, so that case is excluded rather than treated as a rewrite.
if [ "$GATE_REMOTE_SHA" = "$ZERO" ] || [ -z "$GATE_REMOTE_SHA" ]; then
  echo "pre-push: rule 3 — new ref on the remote, nothing to compare (ok)."
elif ! git merge-base --is-ancestor "$GATE_REMOTE_SHA" "$GATE_LOCAL_SHA" 2>/dev/null; then
  echo
  echo "pre-push: BLOCKED — this is NOT a fast-forward (auto-push rule 3)." >&2
  echo "          remote ${GATE_REMOTE_SHA:0:7} is not an ancestor of local ${GATE_LOCAL_SHA:0:7}." >&2
  echo "          A force-push rewrites published history; this rule forbids it" >&2
  echo "          and FAST_PUSH does NOT override this check." >&2
  FAIL=1
fi

# --- Rule 2: clean range (never skippable) ----------------------------------
if [ -x .scratch/check-push-range.sh ]; then
  if ! bash .scratch/check-push-range.sh; then
    echo
    echo "pre-push: BLOCKED by the clean-range check (AGENTS.md auto-push rule 2)."
    FAIL=1
  fi
else
  echo "pre-push: WARNING: .scratch/check-push-range.sh missing — cannot apply" >&2
  echo "          the clean-range rule. Restore it before pushing." >&2
  FAIL=1
fi

# --- Rule 1: gate green (skippable with FAST_PUSH=1) ------------------------
if [ "${FAST_PUSH:-0}" = "1" ]; then
  echo "pre-push: FAST_PUSH=1 — SKIPPING the build/test/lint gate."
  echo "pre-push: the human owns the consequences of an unverified push."
elif [ ! -f package.json ]; then
  echo "pre-push: no package.json — nothing to verify."
elif ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: WARNING: npm not found — cannot run the gate." >&2
  FAIL=1
else
  echo "pre-push: running 'npm run verify' (build + test + lint)..."
  if ! nice -n 19 npm run verify; then
    echo
    echo "pre-push: BLOCKED — 'npm run verify' failed (auto-push rule 1)."
    echo "          Fix the tree, or push with FAST_PUSH=1 to override."
    FAIL=1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo
  echo "pre-push: push refused. Nothing was sent to $REMOTE."
  exit 1
fi

echo "pre-push: PASS — gated push to $REMOTE/master is clean and green."

# --- Human-action reminder --------------------------------------------------
# The end of a batch is the moment the human is most likely present, and the
# moment work that only THEY can do tends to get stranded in task-state.md.
# Informational only — never affects the exit code.
if [ -x scripts/remind-human.sh ]; then
  bash scripts/remind-human.sh --hook
fi

exit 0
