# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment (Supabase credentials — never commit)
.env
.env.*
!.env.example

# Playwright e2e (V2 ticket 00) — marker storageState (session tokens)
# and test artifacts, never commit
e2e/.auth/
test-results/
playwright-report/

# opencode runtime state (session continuation files — not source)
.omo/

# Visual-check screenshots (regenerate with .scratch/v4/shot.mjs)
.scratch/**/*.png

# Verification artifacts that can carry a live session token — never commit
.scratch/**/marker-state.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
