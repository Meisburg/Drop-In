# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment (Supabase credentials — never commit)
.env
.env.*
!.env.example

# Playwright e2e (V2 ticket 00) — marker storageState (session tokens)
# and test artifacts, never commit
e2e/.auth/
test-results/
playwright-report/

# opencode runtime state (session continuation files — not source)
.omo/

# Visual-check screenshots (regenerate with .scratch/v4/shot.mjs)
.scratch/**/*.png

# Verification artifacts that can carry a live session token — never commit
.scratch/**/marker-state.json

# Throwaway commit-message files written by the agent loop
.scratch/**/*.txt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# V7 design exploration — local-only mockups used to pick the palette and the
# mark. They live under public/, so committing them would SHIP them to the
# deployed site. Scratch, not product.
public/logo-mockup.html
public/color-compare.html
logo-mockup.png

# Dev-only verification harnesses (photo-crop tickets 02-04). Root-level HTML so
# `vite dev` transforms and serves them as entries; NOT build inputs, and not
# product code. They mount the real components against a synthetic banded image
# because the crop dialog is otherwise only reachable behind a session.
crop-harness.html
crop-encode-harness.html
crop-flow-harness.html
